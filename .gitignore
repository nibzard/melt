# Python bytecode and build output
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/

# Raw output of the round 1 benchmark runs (backlog task T023). The
# recorded measurement of each run lives under docs/performance; every
# scratch rerun writes under build/, which stays ignored.
build/benchmarks/

# Scratch output of the protocol generation (backlog task T007). The
# generated files themselves are committed under protocol/ so the
# regeneration drift gate can compare them; only scratch copies that
# never belong to the tree stay ignored, together with any Swift
# Package Manager build directory the generated harness creates when
# someone compiles it.
build/protocol/
protocol/generated/.build/
protocol/generated/*.build/

# Virtual environments
.venv/
venv/

# Node modules for the pinned Pi Durable storage adapter probe.
# The committed package-lock.json is the pin (SPEC.md section 14).
node_modules/

# Test and coverage output
.pytest_cache/
.coverage
coverage.xml
htmlcov/

# Tool caches
.mypy_cache/
.ruff_cache/

# Local harness state. Durable workspace data lives under the platform
# data root, never inside the repository (SPEC.md section 14).
var/
logs/

# Runner output of a run staged inside the repository by hand. Every
# real run stages under the workspace data root instead (SPEC.md
# section 13.2).
staging/
staged-outputs.json

# Editor and operating-system noise
.DS_Store
